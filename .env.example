# Copy to .env (same directory as docker-compose.yml) and fill in.
# The compose file fails fast on any of these being unset — by design.

# Wazuh indexer + dashboard passwords (generate: openssl rand -base64 24)
INDEXER_PASSWORD=changeme
DASHBOARD_PASSWORD=changeme

# Wazuh API password for the wazuh-wui service account. Set on the host
# environment and injected at runtime (see the compose manager block).
WAZUH_API_PASSWORD_NEW=changeme

# Token the SOC gateway presents to the realtime ingest API
# (realtime_ingest validates it; see soc-openclaw docs/deploy-guide.md).
OPENCLAW_GATEWAY_TOKEN=changeme

# ./secrets/reports-mailbox.env (created by you, never committed) carries the
# SMTP credentials agentic-soc-send.py reads via os.environ:
#   SMTP_HOST=            # mail host running the reports mailbox
#   SMTP_PORT=587
#   REPORTS_MAILBOX=      # reports@... mailbox address
#   REPORTS_MAILBOX_PW=   # mailbox password
#   LAYA_API_KEY=         # laya-serve API key, if a non-loopback bind is used
#   LAYA_MODE=gated